# Nace API key for Drex (starts with nace_sk_). Leave empty to run on the local stand-in:
# the panel then shows a STAND-IN badge and no request (and no frame) leaves this machine.
NACE_API_KEY=

# Frame calls need a Max model. Per-call overrides: DREX_MODEL_<CALLTYPE>, or server/gateway/models.ts.
DREX_MODEL=drex-max-v1.1

# Account tier, used to pace requests when a key is set: free = 120 requests/min and 8 in flight; paid = 1200 and 16.
DREX_TIER=free

# Stand-in only: rehearse a rate limit (120 = free tier) and simulated latency per call in ms.
# STANDIN_RPM=120
# STANDIN_LATENCY_MS=30-110

PORT=8788
