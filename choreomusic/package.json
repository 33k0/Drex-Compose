{
  "name": "drex-choreomusic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Video to music. Drex Max watches a muted clip, plans a piece around it, then composes and performs it in sync.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:server\" \"npm:web\"",
    "server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-force-exit server/test/*.test.ts server/video/__tests__/*.test.ts web/src/audio/__tests__/*.test.ts web/src/state.test.ts",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts",
    "score": "tsx --env-file-if-exists=.env tools/score-cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tone": "^15.1.22",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
